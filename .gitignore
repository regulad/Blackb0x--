
**/.DS_Store
/build/
/.scratch/
__pycache__/

# bake-firmware's output (see src/BakeFirmware.cpp) —
# locally-produced artifacts, not something to check in.
/dist/

# entrypoint/'s build assets (Apple's own SDK, etc.) — Apple's copyrighted
# material, reproducible locally per entrypoint/assets/README.md, not
# something this project redistributes in its own git history.
/entrypoint/assets/*
!/entrypoint/assets/README.md
# entrypoint/'s compiled output
/entrypoint/entrypoint
/entrypoint/obj/

# cainjector/'s compiled output. The source, the vendored CA bundle and the
# entitlements plist are all checked in; the armv7 binary is reproducible
# from them with `make -C cainjector` and a pinned Xcode.
/cainjector/cainjector

# tweaks/'s compiled output, plus the Substrate framework each Makefile
# unpacks out of debcache/mobilesubstrate_*.deb to build against. The deb is
# vendored; the unpacked copy is a build artifact. Globbed rather than listed
# per tweak so a third one needs no edit here.
/tweaks/*/*.dylib
/tweaks/*/.substrate/
